# StillLoud - environment variables
#
# Copy to .env and fill in. Never commit .env: it holds live credentials.
# On Vercel, set these in Project -> Settings -> Environment Variables.

# --- Database (Neon) -------------------------------------------------------
# Runtime connection: the POOLED string (host contains "-pooler").
DATABASE_URL=
# Same database, unpooled host. Used by migrations / long-running scripts.
DATABASE_URL_UNPOOLED=

# Fallbacks read by payload.config.js if the names above are not set.
DATABASE_URI=
DATABASE_URI_DIRECT=

# --- Payload ---------------------------------------------------------------
# Signing key for sessions and tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 32+ characters in production.
PAYLOAD_SECRET=

# --- Site ------------------------------------------------------------------
# Public origin, no trailing slash. Drives canonicals, JSON-LD, sitemap,
# robots.txt, llms.txt and the RSS feed.
NEXT_PUBLIC_SERVER_URL=https://stillloud.in

# --- Uploads (optional locally, required in production) --------------------
# Vercel Blob read/write token. When absent, Payload writes uploads to
# public/media on local disk (fine for `npm run dev`, not for Vercel).
BLOB_READ_WRITE_TOKEN=
